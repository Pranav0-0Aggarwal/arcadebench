#!/usr/bin/env bash
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

dir=/opt/arcadebench
img=ghcr.io/pranav0-0aggarwal/arcadebench-server
dc() { docker compose -f "$dir/docker-compose.prod.yml" "$@"; }
rd() { cat "$dir/$1" 2>/dev/null || true; }

[ "${1:-}" = current ] && { rd tag; exit 0; }

tag=${1:-}
[[ $tag =~ ^[0-9a-f]{7,40}$ || $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "usage: arcadebench-deploy <tag> | current" >&2; exit 2; }

IFS= read -r token
[ -n "$token" ]

trap 'docker logout ghcr.io >/dev/null 2>&1 || true' EXIT
printf '%s' "$token" | docker login ghcr.io -u deploy --password-stdin >/dev/null

export TAG=$tag
dc pull
dc run --rm -T migrate
dc up -d --wait --wait-timeout 120 --remove-orphans

if [ "$(rd tag)" != "$tag" ]; then
  rd tag > "$dir/tag.prev"
  echo "$tag" > "$dir/tag"
fi

docker images --format '{{.Tag}}' "$img" | grep -vxF -e "$tag" -e "$(rd tag.prev)" | xargs -r -I{} docker rmi "$img:{}" || true
docker image prune -f >/dev/null
